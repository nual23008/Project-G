; Godot 4 project. Open this file in Godot; generated assets are committed.
config_version=5

[application]
config/name="Dư Âm Thế Giới Lãng Quên"
run/main_scene="res://scenes/main/main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/ui/icon.svg"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=640
window/size/min_height=360
window/stretch/mode="viewport"
window/size/mode=3
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.025, 0.06, 0.09, 1)

[physics]
common/physics_ticks_per_second=60

[layer_names]
2d_physics/layer_1="Environment"
2d_physics/layer_2="Player"
2d_physics/layer_3="NPC"

[audio]
default_bus_layout="res://resources/default_bus_layout.tres"
